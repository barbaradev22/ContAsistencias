@using ContAsistencias.data
@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ContAsistencias</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ContAsistencias.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body>
    @{ 
        var rolActual = Context.GetRol();
        var nombreActual = Context.GetNombre();
    }

    <nav class="navbar-custom z-depth-1 grey darken-1">
        <div class="nav-wrapper container">
            <a asp-page="/Index" class="brand-logo left flex-logo">
                <i class="material-icons logo-icon">access_time</i>
                <span class="logo-text">Control Asistencia</span>
            </a>

            <ul id="nav-mobile" class="right hide-on-med-and-down">
                @if (string.IsNullOrWhiteSpace(rolActual))
                {
                    <li>
                        <a asp-page="/Login" class="nav-link">
                            <i class="material-icons left">login</i>Iniciar sesión
                        </a>
                    </li>
                }
                else
                {
                    @if (rolActual == "admin")
                    {
                        <li>
                            <a asp-page="/Index" class="nav-link">
                                <i class="material-icons left">dashboard</i>Administración
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Usuarios/VistaUsuario" class="nav-link">
                                <i class="material-icons left">people</i>Usuarios
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Reportes/VistaReporte" class="nav-link">
                                <i class="material-icons left">assessment</i>Reportes
                            </a>
                        </li>
                        <li>
                            <a asp-page="/Asistencias/VistaAsistencia" class="nav-link">
                                <i class="material-icons left">check_circle</i>Asistencia
                            </a>
                        </li>
                    }
                    else if (rolActual == "empleado")
                    {
                        <li>
                            <a asp-page="/Empleado/VistaEmpleado" class="nav-link">
                                <i class="material-icons left">check_circle</i>Asistencia
                            </a>
                        </li>
                    }

                    <li>
                        <a asp-page="/Login" asp-page-handler="CerrarSesion" class="nav-link">
                            <i class="material-icons left">logout</i>Salir
                        </a>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <div class="container" style="margin-top: 20px;">
        @if (!string.IsNullOrWhiteSpace(nombreActual))
        {
            <div class="right-align grey-text text-darken-1" style="margin-bottom: 10px;">
                Sesión activa: <strong>@nombreActual</strong> (@rolActual)
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
